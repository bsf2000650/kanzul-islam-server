# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---------- Database (MongoDB Atlas) ----------
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://asad:asad@ecommerce.ftp5tco.mongodb.net/kanzul-islam?retryWrites=true
DB_NAME=kanzul_islam_college

# ---------- JWT / Auth ----------
JWT_ACCESS_SECRET=KANZULISLAM_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=KANZULISLAM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- CORS / Frontends ----------
CLIENT_URL=http://localhost:5174        # admin portal
WEBSITE_URL=http://localhost:3000       # public site
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://kanzul-islam-portal.vercel.app/

# ---------- Cookies ----------
COOKIE_SECRET=KANZULISLAM_COOKIE_SECRET
COOKIE_SECURE=false                     # true in production (HTTPS)
COOKIE_SAMESITE=lax                     # use "none" if the frontend is on a different domain in production

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000             # 15 minutes
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10                  # stricter limit for login
INQUIRY_RATE_LIMIT_MAX=5                # limit spam on the public inquiry form

# ---------- File uploads ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---------- Seed (first super admin) ----------
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=SuperAdmin@123!




